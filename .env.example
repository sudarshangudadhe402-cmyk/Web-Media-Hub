# ─── Copy this file to .env and fill in your values ──────────────────────────
# On Replit: set these in the Secrets tab instead of this file.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Secret used to sign JWTs (min 32 random characters)
SESSION_SECRET=change-me-use-a-long-random-string

# Required access code for the super-admin login screen
SUPER_ADMIN_ACCESS_CODE=your-super-admin-code

# Gate code shown on the super-admin Vite frontend
VITE_GATE_CODE=your-gate-code

# ── Optional ──────────────────────────────────────────────────────────────────

# Public URL of the customer-facing store (used in email links)
# Default in development: http://localhost:3000
FRONTEND_URL=https://yourdomain.com

# Comma-separated list of allowed CORS origins (in addition to localhost in dev)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=

# Email used to seed the first super-admin account on first boot
SEED_SUPER_ADMIN_EMAIL=superadmin@yourdomain.com

# Razorpay payment gateway (leave empty to disable payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP for transactional emails (leave empty to disable emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# Optional: MapTiler API key for vector map tiles (falls back to OpenStreetMap)
VITE_MAPTILER_API_KEY=

# ── Ports (for running locally) ────────────────────────────────────────────────
# API server
PORT=8080
# Set BASE_PATH if serving frontends under a subpath
BASE_PATH=/
