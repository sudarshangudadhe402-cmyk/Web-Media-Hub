# ─── Web Media Hub — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values before running locally.
# Lines starting with # are comments. Never commit your real .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=MyApp

# JWT signing secret — use a long random string (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_secret_string

# Required access code for super-admin login (shown on the login form)
SUPER_ADMIN_ACCESS_CODE=change_me_to_a_secure_code

# ── API Server ────────────────────────────────────────────────────────────────

# Port the API server listens on (default: 8080)
PORT=8080

# Node environment: development | production
NODE_ENV=development

# ── CORS — required for public/custom-domain deployment ──────────────────────
# Comma-separated list of allowed frontend origins (include protocol + port)
# Example: ALLOWED_ORIGINS=https://mystore.com,https://admin.mystore.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:21648

# Alternatively, set just the main frontend URL (also used for email links)
FRONTEND_URL=http://localhost:5173

# ── Super Admin Seed (optional) ───────────────────────────────────────────────
# On first boot, if no super_admin user exists, one is created from these values.
# Leave blank after first run (the created account persists in MongoDB).
SEED_SUPER_ADMIN_USERNAME=admin
SEED_SUPER_ADMIN_PASSWORD=change_me_to_a_strong_password
SEED_SUPER_ADMIN_EMAIL=admin@example.com

# ── Email (optional — for OTP and notification emails) ───────────────────────
# Gmail account + App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Payments (optional — for Razorpay integration) ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Logging (optional) ────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info
