modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 20029
externalPort = 3000

[[ports]]
localPort = 21647
externalPort = 80

[[ports]]
localPort = 21648
externalPort = 4200

[[ports]]
localPort = 25880
externalPort = 3002

[userenv]

[userenv.shared]
SUPER_ADMIN_ACCESS_CODE = "@SID352007_SA-WMH"
VITE_GATE_CODE = "@SID-WMH-SA"
SEED_SUPER_ADMIN_EMAIL = "webmediahub.store@gmail.com"
