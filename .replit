modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/clothing-store: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/super-admin: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/shopping-page: web"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "artifacts/clothing-store: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=21647 BASE_PATH=/ pnpm --filter @workspace/clothing-store run dev"
waitForPort = 21647

[[workflows.workflow]]
name = "artifacts/super-admin: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=20029 BASE_PATH=/super-admin/ pnpm --filter @workspace/super-admin run dev"
waitForPort = 20029

[[workflows.workflow]]
name = "artifacts/shopping-page: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=21648 BASE_PATH=/ pnpm --filter @workspace/clothing-store run dev:shopping"
waitForPort = 21648

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 20029
externalPort = 3000

[[ports]]
localPort = 21647
externalPort = 80

[[ports]]
localPort = 21648
externalPort = 4200
